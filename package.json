{
  "name": "boul-business-os",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @boul/web",
    "dev:web": "npm run dev -w @boul/web",
    "dev:api": "npm run build -w @boul/domain && npm run dev -w @boul/api",
    "build": "npm run build -w @boul/domain && npm run build -w @boul/api && npm run build -w @boul/web",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "lint": "npm run lint -w @boul/web && eslint 'apps/api/src/**/*.ts' 'packages/domain/src/**/*.ts'", 
    "db:generate": "npm run db:generate -w @boul/api",
    "db:validate": "npm run db:validate -w @boul/api",
    "db:migrate": "npm run db:migrate -w @boul/api",
    "db:seed": "npm run db:seed -w @boul/api",
    "neon:plan": "neon config plan --project-id curly-rice-23821974 --branch production",
    "neon:deploy": "neon deploy --project-id curly-rice-23821974 --branch production"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@nestjs/platform-express": "^11.2.7"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "neon": "^8.0.11",
    "typescript-eslint": "^8.71.1"
  }
}
