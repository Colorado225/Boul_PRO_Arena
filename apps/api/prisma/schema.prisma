generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled endpoint for application traffic.
  url       = env("DATABASE_URL")
  // Neon direct endpoint for migrations and administrative operations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  DIRECTOR
  GENERAL_MANAGER
  ACCOUNTANT
  FINANCE_MANAGER
  STORE_MANAGER
  PRODUCTION_MANAGER
  BAKER
  CASHIER
  SALES_AGENT
  PURCHASING_MANAGER
  STOCK_MANAGER
  AUDITOR
  ACCOUNTANT_EXTERNAL
  READ_ONLY
}

enum MovementType {
  PURCHASE
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
  REFUNDED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  currency  String    @default("XOF")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users      User[]
  sites      Site[]
  products   Product[]
  materials  RawMaterial[]
  suppliers  Supplier[]
  sales      Sale[]
  movements  StockMovement[]
  auditLogs  AuditLog[]
  sessions   Session[]
  invitations UserInvitation[]
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  passwordHash   String?
  role           Role
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  siteAccesses         UserSiteAccess[]
  sentInvitations      UserInvitation[] @relation("InvitationSender")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Site {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String
  timezone       String       @default("Africa/Abidjan")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sales        Sale[]
  movements    StockMovement[]
  userAccesses UserSiteAccess[]

  @@index([organizationId])
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  salePrice      Int
  costPrice      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  lines SaleLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model RawMaterial {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  baseUnit       String
  quantity       Decimal      @default(0) @db.Decimal(18, 6)
  averageCost    Decimal      @default(0) @db.Decimal(18, 6)
  minimumStock   Decimal      @default(0) @db.Decimal(18, 6)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  movements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Sale {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])
  status         SaleStatus   @default(COMPLETED)
  total          Int
  paymentMethod  String
  idempotencyKey String       @unique
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines SaleLine[]

  @@index([organizationId, createdAt])
  @@index([organizationId, siteId, createdAt])
}

model SaleLine {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(18, 6)
  unitPrice Int
  unitCost  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])
  materialId     String?      @db.Uuid
  material       RawMaterial? @relation(fields: [materialId], references: [id])
  type           MovementType
  quantity       Decimal      @db.Decimal(18, 6)
  unitCost       Decimal      @db.Decimal(18, 6)
  referenceType  String
  referenceId    String       @db.Uuid
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, siteId, createdAt])
  @@index([organizationId, materialId, createdAt])
  @@index([referenceType, referenceId])
}

model UserSiteAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String   @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, siteId])
  @@index([siteId])
}

model UserInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           Role
  siteIds        String[]     @default([]) @db.Uuid
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  invitedBy      User         @relation("InvitationSender", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, email])
  @@index([expiresAt])
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String       @db.Uuid
  action         String
  entity         String
  entityId       String       @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  device         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}
