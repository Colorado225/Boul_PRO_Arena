generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled endpoint for application traffic.
  url       = env("DATABASE_URL")
  // Neon direct endpoint for migrations and administrative operations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  DIRECTOR
  GENERAL_MANAGER
  ACCOUNTANT
  FINANCE_MANAGER
  STORE_MANAGER
  PRODUCTION_MANAGER
  BAKER
  CASHIER
  SALES_AGENT
  PURCHASING_MANAGER
  STOCK_MANAGER
  AUDITOR
  ACCOUNTANT_EXTERNAL
  READ_ONLY
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
  PACKAGE
}

enum MovementType {
  PURCHASE
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
  REFUNDED
}

enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  currency  String    @default("XOF")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users      User[]
  sites      Site[]
  products   Product[]
  materials  RawMaterial[]
  suppliers  Supplier[]
  sales      Sale[]
  movements  StockMovement[]
  auditLogs  AuditLog[]
  sessions   Session[]
  invitations UserInvitation[]
  units        Unit[]
  unitConversions UnitConversion[]
  materialCategories MaterialCategory[]
  recipes      Recipe[]
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  passwordHash   String?
  role           Role
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  siteAccesses         UserSiteAccess[]
  sentInvitations      UserInvitation[] @relation("InvitationSender")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Site {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String
  timezone       String       @default("Africa/Abidjan")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sales        Sale[]
  movements    StockMovement[]
  userAccesses UserSiteAccess[]

  @@index([organizationId])
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  salePrice      Int
  costPrice      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  lines   SaleLine[]
  recipes Recipe[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model MaterialCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  materials RawMaterial[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Unit {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  symbol         String
  dimension      UnitDimension
  decimalPlaces  Int           @default(3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  materialsAsBase     RawMaterial[]  @relation("MaterialBaseUnit")
  materialsAsPurchase RawMaterial[]  @relation("MaterialPurchaseUnit")
  conversionsFrom     UnitConversion[] @relation("ConversionFromUnit")
  conversionsTo       UnitConversion[] @relation("ConversionToUnit")
  recipeIngredients   RecipeIngredient[]
  recipeYields        RecipeVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, dimension])
}

model UnitConversion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUnitId     String       @db.Uuid
  fromUnit       Unit         @relation("ConversionFromUnit", fields: [fromUnitId], references: [id])
  toUnitId       String       @db.Uuid
  toUnit         Unit         @relation("ConversionToUnit", fields: [toUnitId], references: [id])
  factor         Decimal      @db.Decimal(24, 9)
  materialId     String?      @db.Uuid
  material       RawMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, fromUnitId, toUnitId])
  @@index([materialId])
}

model RawMaterial {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  categoryId     String?      @db.Uuid
  category       MaterialCategory? @relation(fields: [categoryId], references: [id])
  baseUnit       String
  baseUnitId     String?      @db.Uuid
  baseUnitRef    Unit?        @relation("MaterialBaseUnit", fields: [baseUnitId], references: [id])
  purchaseUnitId String?      @db.Uuid
  purchaseUnit   Unit?        @relation("MaterialPurchaseUnit", fields: [purchaseUnitId], references: [id])
  quantity       Decimal      @default(0) @db.Decimal(18, 6)
  averageCost    Decimal      @default(0) @db.Decimal(18, 6)
  minimumStock   Decimal      @default(0) @db.Decimal(18, 6)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  movements  StockMovement[]
  conversions       UnitConversion[]
  recipeIngredients RecipeIngredient[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Recipe {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id])
  name           String
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  versions RecipeVersion[]

  @@unique([organizationId, name])
  @@index([organizationId, productId])
}

model RecipeVersion {
  id                  String              @id @default(uuid()) @db.Uuid
  recipeId            String              @db.Uuid
  recipe              Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version             Int
  status              RecipeVersionStatus @default(DRAFT)
  yieldQuantity       Decimal             @db.Decimal(18, 6)
  yieldUnitId         String              @db.Uuid
  yieldUnit           Unit                @relation(fields: [yieldUnitId], references: [id])
  preparationMinutes  Int                 @default(0)
  bakingMinutes       Int                 @default(0)
  restingMinutes      Int                 @default(0)
  bakingTemperatureC  Decimal?            @db.Decimal(6, 2)
  equipment           String[]            @default([])
  instructions        String[]            @default([])
  overheadCost        Decimal             @default(0) @db.Decimal(18, 6)
  targetMarginPercent Decimal             @default(35) @db.Decimal(5, 2)
  materialCost        Decimal             @db.Decimal(18, 6)
  productionCost      Decimal             @db.Decimal(18, 6)
  unitCost            Decimal             @db.Decimal(18, 6)
  recommendedPrice    Int
  createdBy           String              @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  ingredients RecipeIngredient[]

  @@unique([recipeId, version])
  @@index([recipeId, status])
}

model RecipeIngredient {
  id                 String        @id @default(uuid()) @db.Uuid
  recipeVersionId    String        @db.Uuid
  recipeVersion      RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  materialId         String        @db.Uuid
  material           RawMaterial   @relation(fields: [materialId], references: [id])
  quantity           Decimal       @db.Decimal(18, 6)
  unitId             String        @db.Uuid
  unit               Unit          @relation(fields: [unitId], references: [id])
  quantityInBaseUnit Decimal       @db.Decimal(18, 6)
  unitCostSnapshot   Decimal       @db.Decimal(18, 6)
  totalCostSnapshot  Decimal       @db.Decimal(18, 6)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([recipeVersionId, materialId])
  @@index([materialId])
}

model Sale {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])
  status         SaleStatus   @default(COMPLETED)
  total          Int
  paymentMethod  String
  idempotencyKey String       @unique
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines SaleLine[]

  @@index([organizationId, createdAt])
  @@index([organizationId, siteId, createdAt])
}

model SaleLine {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(18, 6)
  unitPrice Int
  unitCost  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])
  materialId     String?      @db.Uuid
  material       RawMaterial? @relation(fields: [materialId], references: [id])
  type           MovementType
  quantity       Decimal      @db.Decimal(18, 6)
  unitCost       Decimal      @db.Decimal(18, 6)
  referenceType  String
  referenceId    String       @db.Uuid
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, siteId, createdAt])
  @@index([organizationId, materialId, createdAt])
  @@index([referenceType, referenceId])
}

model UserSiteAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String   @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, siteId])
  @@index([siteId])
}

model UserInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           Role
  siteIds        String[]     @default([]) @db.Uuid
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  invitedBy      User         @relation("InvitationSender", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, email])
  @@index([expiresAt])
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String       @db.Uuid
  action         String
  entity         String
  entityId       String       @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  device         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}
