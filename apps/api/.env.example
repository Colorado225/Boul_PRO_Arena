# Neon pooled connection string used by the running API.
# Add `?sslmode=require` when it is not already present.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"

# Neon direct (non-pooler) connection used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

API_PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
OPENAPI_ENABLED=true

# Development seed only. Use a unique value and never reuse a real password.
DEMO_OWNER_PASSWORD="change-me-with-at-least-12-characters"
