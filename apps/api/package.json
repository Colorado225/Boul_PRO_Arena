{
  "name": "@boul/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/infrastructure/http/*.test.ts src/infrastructure/config/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@boul/domain": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "nestjs-pino": "^4.4.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@boul/config": "*",
    "@nestjs/cli": "^12.0.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "latest",
    "pino-pretty": "^13.1.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "latest"
  }
}
