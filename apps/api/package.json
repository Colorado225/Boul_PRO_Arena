    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@boul/domain": "*",
    "@nestjs/common": "^11.1.6",
    "@prisma/client": "^6.19.0",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@boul/config": "*",
    "@nestjs/cli": "^11.0.10",
    "@types/node": "latest",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "latest"
  }
}
